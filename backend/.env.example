# Application Settings
APP_NAME="Construction Spec Assistant"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# API Settings
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# MongoDB Settings
# Use docker-compose to start MongoDB: docker-compose up -d mongodb
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="construction_spec_assistant"
MONGODB_MAX_POOL_SIZE=10

# Qdrant Settings
# Use docker-compose to start Qdrant: docker-compose up -d qdrant
# Set QDRANT_USE_MEMORY=false to use persistent Qdrant server
# Set QDRANT_USE_MEMORY=true to use in-memory Qdrant (no Docker needed)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="construction_docs"
QDRANT_USE_MEMORY=true

# LLM Provider Settings
# Options: openai, together, anthropic, ollama
# Default: openai
LLM_PROVIDER="openai"

# OpenAI Settings
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096

# Together.ai Settings
# Get your API key from: https://api.together.xyz/settings/api-keys
# Uncomment and set these values to use Together.ai as your LLM provider
# Set LLM_PROVIDER="together" to enable
# TOGETHER_API_KEY="your-together-api-key-here"
# TOGETHER_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
# TOGETHER_TEMPERATURE=0.0
# TOGETHER_MAX_TOKENS=4096

# Popular Together.ai models:
# - meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo (fast, cost-effective)
# - meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo (more capable)
# - meta-llama/Meta-Llama-3.1-405B-Instruct-Turbo (most capable)
# - mistralai/Mixtral-8x7B-Instruct-v0.1
# - mistralai/Mistral-7B-Instruct-v0.2

# Anthropic Settings (optional)
# Get your API key from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama Settings (optional)
# For local LLM inference with Ollama
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"

# LangSmith Settings (optional)
# LangSmith provides tracing and observability for LLM calls and agent workflows
# Get your API key from: https://smith.langchain.com/
# Sign up, create a project, and generate an API key
# Uncomment and set these values to enable LangSmith tracing
# LANGSMITH_ENABLED=true
# LANGSMITH_API_KEY="your-langsmith-api-key-here"
# LANGSMITH_PROJECT="construction-spec-assistant"
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# LANGSMITH_TRACING_V2=true

# Document Processing Settings
MAX_FILE_SIZE_MB=50
SUPPORTED_FILE_TYPES=[".pdf", ".docx", ".doc"]
UPLOAD_DIR="./data/uploads"

# Docling Settings
DOCLING_USE_OCR=true
DOCLING_OCR_ENGINE="easyocr"

# Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Fact Extraction Settings
FACT_EXTRACTION_BATCH_SIZE=10
FACT_CONFIDENCE_THRESHOLD=0.5

# Retrieval Settings
RETRIEVAL_TOP_K=5
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Comparison Agent Settings
COMPARISON_MAX_RETRIES=3
COMPARISON_MAX_CONCURRENCY=5
COMPARISON_ENABLE_PARALLEL=true

# Tavily Web Search Settings (optional)
# Tavily provides AI-optimized web search for enhancing unclear verdicts
# Get your API key from: https://tavily.com
# Uncomment and set these values to enable web search for unclear comparisons
# TAVILY_API_KEY="your-tavily-api-key-here"
# TAVILY_SEARCH_ENABLED=false
# TAVILY_MAX_RESULTS=3
# TAVILY_SEARCH_DEPTH="advanced"
# TAVILY_TIMEOUT=10
# TAVILY_MIN_RELEVANCE_SCORE=0.5

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update the values in .env with your actual configuration
#
# 3. To use OpenAI (default):
#    - Set LLM_PROVIDER="openai"
#    - Set OPENAI_API_KEY to your OpenAI API key
#    - Optionally adjust OPENAI_MODEL, OPENAI_TEMPERATURE, OPENAI_MAX_TOKENS
#
# 4. To use Together.ai:
#    - Set LLM_PROVIDER="together"
#    - Uncomment and set TOGETHER_API_KEY to your Together.ai API key
#    - Optionally adjust TOGETHER_MODEL, TOGETHER_TEMPERATURE, TOGETHER_MAX_TOKENS
#
# 5. To switch between providers:
#    - Simply change the LLM_PROVIDER value
#    - No code changes required!
#
# 6. For MongoDB and Qdrant:
#    - Update connection settings if using non-default configurations
#    - Set QDRANT_USE_MEMORY=true for in-memory Qdrant (development only)
#
# ============================================================================
# COST COMPARISON
# ============================================================================
#
# OpenAI GPT-4o-mini:
#   - Input: $0.150 / 1M tokens
#   - Output: $0.600 / 1M tokens
#
# Together.ai Meta-Llama-3.1-8B-Instruct-Turbo:
#   - Input: $0.18 / 1M tokens
#   - Output: $0.18 / 1M tokens
#   - Often faster inference
#
# Together.ai Meta-Llama-3.1-70B-Instruct-Turbo:
#   - Input: $0.88 / 1M tokens
#   - Output: $0.88 / 1M tokens
#
# ============================================================================
