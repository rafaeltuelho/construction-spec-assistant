# Application Settings
APP_NAME="Construction Spec Assistant"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# API Settings
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# MongoDB Settings
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="construction_spec_assistant"
MONGODB_MAX_POOL_SIZE=10

# Qdrant Settings
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="construction_docs"
QDRANT_USE_MEMORY=true

# OpenAI Settings
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096

# Anthropic Settings (optional)
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama Settings (optional)
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"

# LangSmith Settings (optional)
# LANGSMITH_API_KEY="your-langsmith-api-key-here"
# LANGSMITH_PROJECT="construction-spec-assistant"

# Document Processing Settings
MAX_FILE_SIZE_MB=50
SUPPORTED_FILE_TYPES=[".pdf", ".docx", ".doc"]
UPLOAD_DIR="./data/uploads"

# Docling Settings
DOCLING_USE_OCR=true
DOCLING_OCR_ENGINE="easyocr"

# Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Fact Extraction Settings
FACT_EXTRACTION_BATCH_SIZE=10
FACT_CONFIDENCE_THRESHOLD=0.5

# Retrieval Settings
RETRIEVAL_TOP_K=5
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Comparison Agent Settings
COMPARISON_MAX_RETRIES=3

